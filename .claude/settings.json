{
  "extraKnownMarketplaces": {
    "rklm": {
      "source": {
        "source": "github",
        "repo": "Rklm-it/site-scanner"
      }
    }
  },
  "enabledPlugins": {
    "playwright@rklm": true,
    "context7@rklm": true,
    "stitch@rklm": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
