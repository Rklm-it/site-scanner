# Reverse-proxy с HTTPS и паролем.
# DOMAIN:
#   - реальный домен (example.com) → Caddy сам выпустит и продлит сертификат;
#   - ":80" → без TLS (доступ по IP), пароль всё равно работает.

# ВАЖНО: домен вписывается в scanner.env (DOMAIN=...), а НЕ вторым блоком в
# этот файл. Второй блок с тем же адресом Caddy не принимает и не стартует
# вовсе — панель ложится целиком. А блок с другим адресом почти наверняка
# останется без basic_auth, и панель откроется в интернет без пароля: там
# база лидов с телефонами, API-ключи и пароль от почты.
{$DOMAIN} {
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# Таблица лидов уезжает одним большим JSON — сжатие заметно ускоряет
	# открытие вкладки «Все лиды» на мобильном интернете.
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	# Сервис называется app и слушает 8600 — имена и порт берутся из
	# docker-compose.yml, а не из головы.
	reverse_proxy app:8600
}

# --------------------------------------------------------------------------- #
# Прототипы клиентов. По блоку на каждого, поднимаются скриптом
# deploy/prototype/deploy.sh — там же и как добавить следующего.
#
# Почему блоки живут прямо здесь, а не дописываются на сервере руками: файл
# под git, и любая ручная правка делает дерево «грязным». После этого
# `git pull --rebase` отказывается работать до stash или checkout — на этом
# уже дважды застревали при обновлении сканера.
#
# Пароля тут нет намеренно: ссылку открывает клиент, и упираться в окно
# авторизации он не должен. В блоке сканера выше пароль обязателен — там
# телефоны, ключи и почта. Здесь публичная страница с фотографиями домов.
#
# X-Frame-Options тоже не ставим: прототип иногда показывают во фрейме.
# --------------------------------------------------------------------------- #

# projekt-doma.ru — Андрей Гординский, прототип к звонку
projekt-review.nexus-flow.ru {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Имя контейнера задаёт deploy.sh как proto-<имя>, порт внутри — 3000
	reverse_proxy proto-projekt-doma:3000
}
