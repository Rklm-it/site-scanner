__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Выгрузки лидов и локальные конфиги
leads.csv
leads.json
out/
*.local.yaml
.env

# Кэш и БД
cache.sqlite
*.sqlite
*.sqlite-journal

# Веб-интерфейс: секреты и данные прогонов
secrets.local.json
webapp_data/

# Деплой: файл с доменом/паролем
scanner.env

# Локальные копии конфига Caddy. В боевом Caddyfile на сервере правится домен,
# а иногда туда же вписывают хэш пароля вместо переменной — такие копии рядом
# с репозиторием ждут только случайного `git add -A`.
Caddyfile.backup
Caddyfile.local
*.backup

# Выгрузки сайтов клиентов: сами файлы держим в репозитории (их читает
# новая сессия), но тяжёлое — нет, иначе репозиторий раздуется.
clients/**/*.mp4
clients/**/*.avi
clients/**/*.mov
clients/**/*.zip
clients/**/*.rar
clients/**/*.pdf
clients/**/*.woff*
clients/**/*.ttf
# Картинки, докачанные списком мимо выгрузки: их отбирают глазами, а в git
# идут только те, что реально пошли на сайт. Одним `git add -A` сюда иначе
# заезжают десятки мегабайт разом.
clients/**/фото/файлы/
