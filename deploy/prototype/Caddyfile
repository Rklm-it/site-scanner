# Caddy для сервера прототипов. К сканеру отношения не имеет — у того свой
# Caddyfile в корне репозитория, с паролем и другим доменом.
#
# По блоку на клиента. Пароля здесь нет намеренно: ссылку открывает клиент, и
# упираться в окно авторизации он не должен. В блоке сканера пароль обязателен,
# там телефоны, ключи и почта; здесь — публичная страница с фотографиями домов.
#
# X-Frame-Options не ставим: прототип иногда удобно показать во фрейме.
#
# Отдаём статику, а не проксируем: страница собирается вне сервера, и здесь
# нужен только раздатчик файлов. Ни node, ни контейнера на клиента, ни
# перезагрузки Caddy при обновлении — файлы читаются на каждый запрос.
#
# Папка приходит из sync.sh в /root/prototypes-static/<имя>, внутрь
# контейнера смонтирована как /srv/<имя>.
#
# Править этот файл — только здесь, в репозитории: на сервере ручная правка
# сделает дерево «грязным», и следующий git pull упрётся в unstaged changes.

# projekt-doma.ru — Андрей Гординский, прототип к звонку
projekt-review.nexus-flow.ru {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	root * /srv/projekt-doma
	file_server

	# Одностраничник: любой неизвестный путь отдаём index.html, чтобы
	# ссылка с «хвостом» не приводила на 404.
	try_files {path} {path}/ /index.html

	# Картинки, бандл и шрифты именованы с хешем либо неизменны, их можно
	# кэшировать надолго. Саму разметку — нет: она меняется на каждом
	# обновлении прототипа.
	@static path /assets/* /projects/* /fonts/*
	header @static Cache-Control "public, max-age=2592000, immutable"

	# Разметку кэшировать нельзя: она меняется на каждом обновлении и тянет
	# за собой новые имена бандла. Матчер обязан включать «/» — раньше здесь
	# стояло только `/index.html`, а браузер запрашивает корень, под правило
	# не попадал и держал старую страницу со ссылками на старый бандл.
	# Снаружи выглядело так, будто выкладка не сработала: curl показывал
	# новое, браузер — старое.
	@html path / /index.html
	header @html Cache-Control "no-cache"
}

# rgz61.ru — ООО «РГЗ», Ростовский гибочный завод. Прототип к согласованию.
#
# Выкладка как у projekt-doma, готовой сборкой из ветки `deploy`:
#
#   ./sync.sh rgz61 https://github.com/Rklm-it/rostov-steel-forge.git
#
# Проект собран в Lovable, репозиторий Rklm-it/rostov-steel-forge. Содержимое
# для него собрано вручную из скриншотов и карточки лида: сайт клиента стоит
# на конструкторе «Пульс цен» и выгрузке не поддаётся — см.
# clients/rgz61.ru/README.md.
rgz61.nexus-flow.ru {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	root * /srv/rgz61
	file_server

	try_files {path} {path}/ /index.html

	# Бандл именован с хешем — кэшируется надолго; разметка меняется на каждом
	# обновлении прототипа, её кэшировать нельзя.
	@static path /assets/*
	header @static Cache-Control "public, max-age=2592000, immutable"

	# «/» обязателен в матчере — см. пояснение в блоке projekt-doma.
	@html path / /index.html
	header @html Cache-Control "no-cache"
}

# papinalavka.ru — «Папина лавка», Воронеж. Макет главной к разговору с
# хозяином: клиенту четыре года делает сайт другая фирма, и он его до сих пор
# не видел. Ссылка нужна именно поэтому — показать можно с любого телефона.
#
# Здесь одна страница целиком: картинки и шрифты вшиты в неё base64, отдельного
# каталога assets нет. Собирается скриптом clients/papinalavka.ru/макет/собрать.py
# прямо в /root/prototypes-static/papinalavka — sync.sh тут не нужен, репозитория
# у этого макета нет.
lavka-review.nexus-flow.ru {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	root * /srv/papinalavka
	file_server

	try_files {path} {path}/ /index.html

	# Кэшировать нечего: вся страница — один файл, и он меняется с каждой
	# правкой макета. Показ идёт живьём, устаревшая версия дороже трафика.
	header Cache-Control "no-cache"
}

# reklamabataysk.ru — рекламное агентство «ПОКОТИЛОВ», Батайск. Прототип к звонку.
#
# Выкладка не как у соседей: страница собрана кодом и лежит в этом же
# репозитории, ветки `deploy` и сборки нет вовсе.
#
#   ./sync-local.sh reklamabataysk clients/reklamabataysk.ru/prototype
reklamabataysk.nexus-flow.ru {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	root * /srv/reklamabataysk
	file_server

	try_files {path} {path}/ /index.html

	# Фотографии щитов и шрифты именами не хешируются, но и не меняются:
	# кэшируем на неделю, а не на месяц, чтобы замена фотографии доехала до
	# клиента, которому уже показывали ссылку.
	@static path /images/* /fonts/*
	header @static Cache-Control "public, max-age=604800"
	header /index.html Cache-Control "no-cache"
}

# mebel-ryazane.ru — ИП Недорезов, мебельный цех в Рязани. Прототип к звонку.
#
# Выкладка готовой сборкой из ветки `deploy`:
#
#   ./sync.sh mebel-ryazane https://github.com/Rklm-it/project-ab16b9fc-3661-4638-b332-fc0eab64dce7.git
#
# Проект собран в Lovable, репозиторий приватный — на сервере нужен токен с
# правами Contents: Read (см. README, раздел про credential.helper).
mebel-review.nexus-flow.ru {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	root * /srv/mebel-ryazane
	file_server

	try_files {path} {path}/ /index.html

	# Бандл именован с хешем — кэшируется надолго. Фотографии работ приедут
	# позже и будут заменяться по ходу показа, поэтому им неделя, а не месяц.
	@static path /assets/*
	header @static Cache-Control "public, max-age=2592000, immutable"
	@foto path /images/*
	header @foto Cache-Control "public, max-age=604800"

	# «/» обязателен в матчере — см. пояснение в блоке projekt-doma.
	@html path / /index.html
	header @html Cache-Control "no-cache"
}
