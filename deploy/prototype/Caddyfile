# Caddy для сервера прототипов. К сканеру отношения не имеет — у того свой
# Caddyfile в корне репозитория, с паролем и другим доменом.
#
# По блоку на клиента. Пароля здесь нет намеренно: ссылку открывает клиент, и
# упираться в окно авторизации он не должен. В блоке сканера пароль обязателен,
# там телефоны, ключи и почта; здесь — публичная страница с фотографиями домов.
#
# X-Frame-Options не ставим: прототип иногда удобно показать во фрейме.
#
# Отдаём статику, а не проксируем: страница собирается вне сервера, и здесь
# нужен только раздатчик файлов. Ни node, ни контейнера на клиента, ни
# перезагрузки Caddy при обновлении — файлы читаются на каждый запрос.
#
# Папка приходит из sync.sh в /root/prototypes-static/<имя>, внутрь
# контейнера смонтирована как /srv/<имя>.
#
# Править этот файл — только здесь, в репозитории: на сервере ручная правка
# сделает дерево «грязным», и следующий git pull упрётся в unstaged changes.

# projekt-doma.ru — Андрей Гординский, прототип к звонку
projekt-review.nexus-flow.ru {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	root * /srv/projekt-doma
	file_server

	# Одностраничник: любой неизвестный путь отдаём index.html, чтобы
	# ссылка с «хвостом» не приводила на 404.
	try_files {path} {path}/ /index.html

	# Картинки и бандл именованы с хешем, их можно кэшировать надолго.
	# Саму разметку — нет: она меняется на каждом обновлении прототипа.
	@static path /assets/* /projects/*
	header @static Cache-Control "public, max-age=2592000, immutable"
	header /index.html Cache-Control "no-cache"
}

# rgz61.ru — ООО «РГЗ», Ростовский гибочный завод. Прототип к согласованию.
#
# Выкладка как у projekt-doma, готовой сборкой из ветки `deploy`:
#
#   ./sync.sh rgz61 https://github.com/Rklm-it/rostov-steel-forge.git
#
# Проект собран в Lovable, репозиторий Rklm-it/rostov-steel-forge. Содержимое
# для него собрано вручную из скриншотов и карточки лида: сайт клиента стоит
# на конструкторе «Пульс цен» и выгрузке не поддаётся — см.
# clients/rgz61.ru/README.md.
rgz61.nexus-flow.ru {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	root * /srv/rgz61
	file_server

	try_files {path} {path}/ /index.html

	# Бандл именован с хешем — кэшируется надолго; разметка меняется на каждом
	# обновлении прототипа, её кэшировать нельзя.
	@static path /assets/*
	header @static Cache-Control "public, max-age=2592000, immutable"
	header /index.html Cache-Control "no-cache"
}
