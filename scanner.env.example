# Скопируй в scanner.env и заполни (в .gitignore — в репозиторий не попадёт).
# ВАЖНО: имя именно scanner.env, НЕ .env — иначе docker compose испортит хэш.

# Домен, на который указывает A-запись сервера → будет авто-HTTPS.
# Нет домена? Поставь :80 (доступ по IP по http, но с паролем).
DOMAIN=scanner.example.com

# Логин для входа (basic-auth)
BASIC_AUTH_USER=admin

# bcrypt-хэш пароля. Лучше сгенерировать командой из DEPLOY.md (шаг 4) —
# она сама подставит и удвоит $. Если заполняешь вручную:
#   docker run --rm caddy caddy hash-password --plaintext 'ТВОЙ_ПАРОЛЬ'
# и замени в результате КАЖДЫЙ $ на $$ (требование docker compose),
# иначе хэш испортится и вход не сработает.
BASIC_AUTH_HASH=$$2a$$14$$replace_me_with_generated_hash
