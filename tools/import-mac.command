#!/usr/bin/env bash
#
# Принять чужую выгрузку сайта с компьютера владельца (macOS).
#
# То же, что `python3 tools/import_dump.py <архив> <домен>`, но запускается
# двойным щелчком из Finder и спрашивает, чего не хватает. Путь к архиву
# проще всего не набирать, а перетащить файл мышкой в это окно — Терминал
# подставит путь сам.
#
# Зачем: сайт клиента не всегда снимаем мы. Бывает архив от прошлого
# подрядчика или папка, скачанная сторонней качалкой. Приёмник приводит её к
# нашему виду — UTF-8, manifest.json, без тяжёлого — и кладёт в
# clients/<домен>/full/, откуда её читает новая сессия.
#
# Виртуальное окружение не нужно: скрипт на голой стандартной библиотеке,
# системного python3 достаточно.
#
set -euo pipefail

cd "$(dirname "$0")/.."          # корень репозитория, откуда бы ни запустили

SRC="${1:-}"
DOMAIN="${2:-}"

if [ -z "$SRC" ]; then
    printf 'Перетащите сюда архив или папку с сайтом и нажмите Enter: '
    read -r SRC
fi
# Finder при перетаскивании экранирует пробелы и иногда добавляет кавычки.
SRC="${SRC%\'}"; SRC="${SRC#\'}"
SRC="$(printf '%s' "$SRC" | sed -E 's/\\ / /g')"

if [ -z "$DOMAIN" ]; then
    printf 'Домен сайта (например drug-domain.ru): '
    read -r DOMAIN
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "Нужен Python 3. Поставьте его командой:  xcode-select --install" >&2
    exit 1
fi

# Пустой третий аргумент argparse считает лишним и падает, поэтому
# --force добавляем только когда он вправду передан.
EXTRA=()
[ "${3:-}" != "" ] && EXTRA+=("$3")

python3 tools/import_dump.py "$SRC" "$DOMAIN" "${EXTRA[@]+"${EXTRA[@]}"}"
